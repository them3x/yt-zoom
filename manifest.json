{
  "manifest_version": 2,
  "name": "YouTube Video Zoom",
  "version": "1.1",
  "description": "Zoom in on YouTube videos using the mouse scroll wheel.",
  "permissions": ["storage"],
  "icons": {
    "128": "logo.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Video Zoom",
    "default_icon": "logo.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
